config RGBLED_WIDGET_BRIGHTNESS
    int "Global brightness scale, percent"
    range 1 100
    default 30
    help
      Every colour is scaled by this before being written to the strip.
      A bare WS2812 sitting under your palm at full duty is painfully
      bright; start low and raise it if you cannot see the indicator.

config RGBLED_WIDGET_GAIN_R
    int "Red channel gain, percent of the value written in the colour"
    range 0 100
    default 100
    help
      100 leaves the channel exactly as the hex colour says, so 0xFFFFFF is
      white and 0x808080 is grey. Lower it only to correct a die that reads too
      bright on your particular LED -- any value below 100 means hex codes no
      longer render literally, so prefer adjusting the colours themselves.

config RGBLED_WIDGET_GAIN_G
    int "Green channel gain, percent of the value written in the colour"
    range 0 100
    default 100
    help
      100 leaves the channel exactly as the hex colour says, so 0xFFFFFF is
      white and 0x808080 is grey. Lower it only to correct a die that reads too
      bright on your particular LED -- any value below 100 means hex codes no
      longer render literally, so prefer adjusting the colours themselves.

config RGBLED_WIDGET_GAIN_B
    int "Blue channel gain, percent of the value written in the colour"
    range 0 100
    default 100
    help
      100 leaves the channel exactly as the hex colour says, so 0xFFFFFF is
      white and 0x808080 is grey. Lower it only to correct a die that reads too
      bright on your particular LED -- any value below 100 means hex codes no
      longer render literally, so prefer adjusting the colours themselves.


config RGBLED_WIDGET_BATTERY_GRADIENT
    bool "Show battery level as a gradient between the HIGH, MEDIUM and LOW colours"
    default y
    help
      Blends the threshold colours instead of jumping between them:
      BATTERY_RGB_HIGH at BATTERY_LEVEL_HIGH and above, BATTERY_RGB_LOW at
      BATTERY_LEVEL_LOW and below, BATTERY_RGB_MEDIUM halfway between the
      two levels, and a smooth blend in between. The blend keeps the
      brightness of its two ends, so it does not dim halfway between two
      colours that sit far apart. With the defaults: green from 80%,
      yellow at 45%, red at 10%. When disabled, the three colours switch
      at the two levels.

config RGBLED_WIDGET_BATTERY_PULSE
    bool "Periodically pulse a warning while the battery is low"
    depends on ZMK_BATTERY_REPORTING
    default y
    help
      zmk_battery_state_changed only fires when the reported percentage
      actually changes, which near the bottom of the range can be an hour
      apart. This polls the cached level on a timer instead, so the warning
      appears at a predictable cadence.

if RGBLED_WIDGET_BATTERY_PULSE

config RGBLED_WIDGET_BATTERY_PULSE_LEVEL
    int "Pulse at and below this battery percentage"
    range 1 100
    default RGBLED_WIDGET_BATTERY_LEVEL_LOW
    help
      BATTERY_LEVEL_LOW by default: the pulse starts where the battery
      colour has become BATTERY_RGB_LOW.

config RGBLED_WIDGET_BATTERY_PULSE_PERIOD_S
    int "Seconds between pulse groups"
    default 60

config RGBLED_WIDGET_BATTERY_PULSE_COUNT
    int "Number of blinks per group"
    range 1 8
    default 3

config RGBLED_WIDGET_BATTERY_PULSE_MS
    int "Duration of each pulse blink in ms"
    default 100

config RGBLED_WIDGET_BATTERY_PULSE_GAP_MS
    int "Gap between blinks within a group, in ms"
    default 150

config RGBLED_WIDGET_BATTERY_PULSE_RGB
    hex "Colour of the low battery pulse (0xRRGGBB)"
    default 0xFF0000

endif # RGBLED_WIDGET_BATTERY_PULSE

config RGBLED_WIDGET_POWER_CONNECTED_BREATHE
    bool "Breathe in the full battery colour when USB power arrives"
    # The nRF52 VBUS detector sits in POWER wherever there is USBD.
    depends on (SOC_SERIES_NRF52X && HAS_HW_NRF_USBD) || USB_DEVICE_STACK
    default y
    help
      When USB power arrives, the LED breathes in BATTERY_RGB_HIGH: from
      dark up to the colour as it normally shows (at BRIGHTNESS) and back,
      POWER_CONNECTED_BREATHE_COUNT times. At boot and on waking from deep
      sleep with USB power it takes the place of the battery colour, which
      says nothing on a cable. It tells of the power, not of charging: a
      full battery breathes too.

      On a half that can send keys over USB, a computer is first given up
      to a second to take the connection: if the keys move to USB, that
      connection blink comes first and the breathe after it, in full. A
      connection blink while it breathes shows at once, and the breathe
      starts over. It stops when the power goes, and a new layer colour
      ends it as it ends every indication.

config RGBLED_WIDGET_POWER_CONNECTED_BREATHE_COUNT
    int "Breaths when USB power arrives"
    depends on RGBLED_WIDGET_POWER_CONNECTED_BREATHE
    range 1 10
    default 2

config RGBLED_WIDGET_POWER_CONNECTED_BREATHE_CYCLE_MS
    int "Duration of one breath, dark to full and back, in ms"
    depends on RGBLED_WIDGET_POWER_CONNECTED_BREATHE
    range 200 10000
    default 2000

config RGBLED_WIDGET_BLANK_TIMEOUT_MS
    int "Default blanking time in ms, used by any layer that does not set its own (0 = never)"
    default 1000
    help
      Independent of ZMK's activity state. This matters on a split peripheral:
      ZMK raises ZMK_ACTIVITY_IDLE only on the ACTIVE -> IDLE transition, so a
      peripheral you never touch goes idle exactly once. Every layer colour the
      central pushes after that lights the LED again with no further idle event
      to turn it back off, leaving it lit for hours. This timer covers that.

      Sub-second values turn the indicator into a flash on change rather than
      a steady light, which matters a lot for battery: an auto-activated mouse
      layer toggles constantly during trackball use, so a steady colour there
      means the LED is lit essentially all the time. 800 ms is still easy to
      catch out of the corner of your eye. Set 0 to keep the colour until the
      next change.

config RGBLED_WIDGET_OFF_ON_IDLE
    bool "Turn the LED off when the keyboard goes idle"
    default y
    help
      A lit WS2812 draws milliamps continuously -- far more than anything else
      on an idle keyboard. Deep sleep already blanks it, but ZMK_IDLE_TIMEOUT
      fires much sooner than ZMK_IDLE_SLEEP_TIMEOUT, so blanking on idle as
      well cuts LED-on time dramatically while keeping the indicator visible
      whenever you are actually typing. The colour is restored on the next
      keypress.

config RGBLED_WIDGET_CONN_REMIND
    bool "Periodically re-blink while the link is down"
    default y
    help
      Connection status is otherwise shown only on a change and once at
      boot, so a keyboard whose link is down shows nothing after that one
      blink. This repeats a short blink in the status colour until the
      link comes up: CONN_RGB_DISCONNECTED, or CONN_RGB_ADVERTISING while
      the profile is open for pairing. On a central that means the active
      BLE profile (nothing while the output is USB); on a peripheral, the
      link to the central. The first reminder comes CONN_REMIND_PERIOD_S
      after the last connection blink, then one every period, idle or not,
      until the link is up or the keyboard sleeps.

config RGBLED_WIDGET_CONN_REMIND_PERIOD_S
    int "Seconds between reminder blinks"
    depends on RGBLED_WIDGET_CONN_REMIND
    default 5

config RGBLED_WIDGET_CONN_REMIND_BLINK_MS
    int "Duration of a reminder blink in ms"
    depends on RGBLED_WIDGET_CONN_REMIND
    default 300

config RGBLED_WIDGET_LAYER_PUSH
    bool "Mirror the layer colour onto split peripherals"
    depends on RGBLED_WIDGET_SHOW_LAYER_COLORS && ZMK_SPLIT && ZMK_SPLIT_ROLE_CENTRAL
    default y
    help
      On by default wherever layer colours are shown on a split central;
      =n turns it off. ZMK has no split message for layer state, so the
      central sends the resolved colour and its blanking time to each
      peripheral as the lyr_sync behavior, which this module declares; the
      peripheral needs no copy of the layer table, but does need this
      module. The latest colour always wins.

      Over Bluetooth one write goes at a time to each peripheral: a change
      goes out at once, and while a write waits for the peripheral's
      acknowledgement only the latest colour waits behind it. Writes to the
      split link hold Bluetooth buffers the central shares with its reports
      to the computer until they are acknowledged, and a peripheral that
      has gone away but is not yet declared lost acknowledges nothing -- so
      it holds one at most, and a trackball on the central is not starved.
      A write that stays unacknowledged past the supervision timeout on a
      link that is up is stuck in the host's queue and is sent again; for
      that moment the two are both held. Each new link is sent the current
      colour.

      On a central with a pointing device, CONFIG_BT_L2CAP_TX_BUF_COUNT=10
      (with CONFIG_BT_BUF_ACL_TX_COUNT=10) gives the reports to the
      computer twice the default room. It also makes much rarer a Zephyr
      3.5 fault that loses a buffer for good when the split link drops
      while a write waits for one.

      Over a wired split the colour goes through ZMK's own split command,
      from the system work queue as ZMK sends its own. ZMK does not report
      a wired peripheral coming back, so one that was unplugged or
      restarted shows the colour from the next layer change on. A build
      with both transports sends over Bluetooth only.

config RGBLED_WIDGET_LAYER_PUSH_STACK_SIZE
    int "Stack of the thread that sends the layer colour"
    depends on RGBLED_WIDGET_LAYER_PUSH && ZMK_SPLIT_BLE
    default 1792 if LOG
    default 1280
    help
      Over Bluetooth the colour is sent from a work queue of its own, where
      waiting for a Bluetooth buffer holds up nothing else. Its deepest
      path measures about 1.2 KB with logging and 0.5 KB without, plus
      about 0.2 KB for the queue and an interrupt; the build stops below
      1536 and 1024. A wired split sends from the system work queue.

config RGBLED_WIDGET_LAYER_PUSH_THREAD_PRIORITY
    int "Priority of the thread that sends the layer colour"
    depends on RGBLED_WIDGET_LAYER_PUSH && ZMK_SPLIT_BLE
    range 0 14
    default 10
    help
      Preemptible, as ZMK's own low-priority work queue.

