    default 0xFF0000
    help
      A level of 0 means nothing measured -- so, for all the keyboard can
      tell, no charge: the low battery colour by default. The log tells it
      from a battery that is really low.

# Connectivity indicator settings
config RGBLED_WIDGET_CONN_BLINK_MS
    int "Duration of a connection status blink in ms"
    default 1000
    help
      The blink on a connection event: connected, lost, a profile switched
      or opened for pairing, and the status at boot. The reminder while the
      link is down has its own, CONN_REMIND_BLINK_MS.

config RGBLED_WIDGET_CONN_SHOW_USB
    bool "Show USB indicator instead of BLE status if it has priority"
    default y
    help
      Blink CONN_RGB_USB when the keys go to USB, and the BLE status when
      they go back: the indicator follows where the keys go, not the
      power. ZMK sends them over USB once a computer has taken the USB
      connection, and over Bluetooth while a connected profile is the
      preferred output (&out). A charger changes nothing, nor does a cable
      while the keys stay on Bluetooth. Off: on USB the connection blinks
      show the BLE profile, and a change of output does not blink.

config RGBLED_WIDGET_CONN_RGB_CONNECTED
    hex "Color for connected BLE connection status (0xRRGGBB)"
    default 0x0000FF

