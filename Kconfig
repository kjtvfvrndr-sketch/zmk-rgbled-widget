config RGBLED_WIDGET_BRIGHTNESS
    int "Global brightness scale, percent"
    range 1 100
    default 40
    help
      Every colour is scaled by this before being written to the strip.
      A bare WS2812 sitting under your palm at full duty is painfully
      bright; start low and raise it if you cannot see the indicator.

config RGBLED_WIDGET_GREEN_TRIM
    int "Green channel trim, percent"
    range 1 100
    default 70
    help
      The green die in a WS2812 is perceptually brighter than the red one
      at equal duty, so an even mix reads as green rather than yellow.
      This scales green only, and is applied once for every colour source.
      Tune it by eye: raise it if yellow looks orange, lower it if yellow
      looks green.

config RGBLED_WIDGET_BATTERY_GRADIENT
    bool "Show battery level as a green-to-red gradient"
    default y
    help
      Replaces the HIGH/MEDIUM/LOW threshold colours with a continuous hue
      sweep: 100% is green, 50% is yellow, 0% is red. When disabled, the
      BATTERY_RGB_HIGH/MEDIUM/LOW settings are used instead.

config RGBLED_WIDGET_BATTERY_PULSE
    bool "Periodically pulse a warning while the battery is low"
    depends on ZMK_BATTERY_REPORTING
    help
      zmk_battery_state_changed only fires when the reported percentage
      actually changes, which near the bottom of the range can be an hour
      apart. This polls the cached level on a timer instead, so the warning
      appears at a predictable cadence.

if RGBLED_WIDGET_BATTERY_PULSE

config RGBLED_WIDGET_BATTERY_PULSE_LEVEL
    int "Pulse below this battery percentage"
    range 1 100
    default 10

config RGBLED_WIDGET_BATTERY_PULSE_PERIOD_S
    int "Seconds between pulse groups"
    default 60

config RGBLED_WIDGET_BATTERY_PULSE_COUNT
    int "Number of blinks per group"
    range 1 8
    default 3

config RGBLED_WIDGET_BATTERY_PULSE_MS
    int "Duration of each pulse blink in ms"
    default 100

config RGBLED_WIDGET_BATTERY_PULSE_GAP_MS
    int "Gap between blinks within a group, in ms"
    default 150

config RGBLED_WIDGET_BATTERY_PULSE_RGB
    hex "Colour of the low battery pulse (0xRRGGBB)"
    default 0xFF0000

endif # RGBLED_WIDGET_BATTERY_PULSE

config RGBLED_WIDGET_OFF_ON_IDLE
    bool "Turn the LED off when the keyboard goes idle"
    default y
    help
      A lit WS2812 draws milliamps continuously -- far more than anything else
      on an idle keyboard. Deep sleep already blanks it, but ZMK_IDLE_TIMEOUT
      fires much sooner than ZMK_IDLE_SLEEP_TIMEOUT, so blanking on idle as
      well cuts LED-on time dramatically while keeping the indicator visible
      whenever you are actually typing. The colour is restored on the next
      keypress.

config RGBLED_WIDGET_CONN_REMIND
    bool "Periodically re-blink while the link is down"
    help
      Upstream indicates connectivity only on state-change events and once
      at boot, so a keyboard that never connected shows nothing after the
      initial blink. This adds a steady heartbeat until the link comes up.
      On a central that means the BLE profile; on a peripheral it means the
      link to the central.

config RGBLED_WIDGET_CONN_REMIND_PERIOD_S
    int "Seconds between reminder blinks"
    depends on RGBLED_WIDGET_CONN_REMIND
    default 5

config RGBLED_WIDGET_LAYER_PUSH
    bool "Mirror the layer colour onto split peripherals"
    depends on RGBLED_WIDGET_SHOW_LAYER_COLORS && ZMK_SPLIT && ZMK_SPLIT_ROLE_CENTRAL
    help
      ZMK has no split message for layer state, so the central pushes the
      resolved colour to each peripheral as a behavior invocation. param1
      is a uint32_t, so the whole 0xRRGGBB value fits and the peripheral
      needs no copy of the layer table. Requires the lyr_sync behavior node,
      which this module declares.

endif # RGBLED_WIDGET

DT_COMPAT_ZMK_BEHAVIOR_RGBLED_WIDGET := zmk,behavior-rgbled-widget
DT_COMPAT_ZMK_BEHAVIOR_RGBLED_SYNC := zmk,behavior-rgbled-sync

config ZMK_BEHAVIOR_RGBLED_WIDGET
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_RGBLED_WIDGET))

# Driven by its own compatible, not by the widget behavior's. The lyr_sync node
# is declared without /omit-if-no-ref/ (the central finds it by name over the
# split link, so nothing in a keymap references it), which means this compatible
# is enabled whenever the module is present.
config ZMK_BEHAVIOR_RGBLED_SYNC
    bool
    depends on RGBLED_WIDGET
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_RGBLED_SYNC))
