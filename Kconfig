# The widget logs under its own module rather than ZMK's, so its output can
# be turned down without touching anything else. Default is INF: start-up,
# connection, battery and idle events. _WRN keeps only errors; _DBG adds the
# per-layer-change lines, which arrive every time the auto-mouse layer
# toggles.
module = RGBLED_WIDGET
module-str = rgbled_widget
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

endif # RGBLED_WIDGET

DT_COMPAT_ZMK_BEHAVIOR_RGBLED_WIDGET := zmk,behavior-rgbled-widget
DT_COMPAT_ZMK_BEHAVIOR_RGBLED_SYNC := zmk,behavior-rgbled-sync

config ZMK_BEHAVIOR_RGBLED_WIDGET
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_RGBLED_WIDGET))

# Driven by its own compatible, not by the widget behavior's. The lyr_sync node
# is declared without /omit-if-no-ref/ (the central finds it by name over the
# split link, so nothing in a keymap references it), which means this compatible
# is enabled whenever the module is present.
config ZMK_BEHAVIOR_RGBLED_SYNC
    bool
    depends on RGBLED_WIDGET
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_RGBLED_SYNC))
