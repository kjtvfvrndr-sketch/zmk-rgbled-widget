/ {
    behaviors {
        /omit-if-no-ref/ ind_bat: ind_bat {
            compatible = "zmk,behavior-rgbled-widget";
            #binding-cells = <0>;
            indicate-battery;
        };
        /omit-if-no-ref/ ind_con: ind_con {
            compatible = "zmk,behavior-rgbled-widget";
            #binding-cells = <0>;
            indicate-connectivity;
        };
        /omit-if-no-ref/ ind_lyr: ind_lyr {
            compatible = "zmk,behavior-rgbled-widget";
            #binding-cells = <0>;
            indicate-layer;
        };

        /*
         * NOTE: deliberately NOT /omit-if-no-ref/. This node is never named in
         * a keymap -- the central looks it up by name over the split link -- so
         * omit-if-no-ref would drop it from the devicetree and the lookup on
         * the peripheral would return NULL.
         */
        lyr_sync: lyr_sync {
            compatible = "zmk,behavior-rgbled-sync";
            #binding-cells = <1>;
        };
    };
};
